# Copy this file to .env and fill in your own values for local development.

# Get this from a free Neon project (https://neon.tech) — same connection
# string works for local dev and for the Render deployment.
DATABASE_URL=postgresql://user:password@host/dbname

# Comma-free single origin (or "*" for local dev). In production, set this to
# your Netlify PWA URL, e.g. https://your-shopping-list.netlify.app
ALLOWED_ORIGINS=*

# Push notifications (OneSignal). Leave unset to disable.
# App ID and REST API key: OneSignal dashboard -> Settings -> Keys & IDs.
# The REST API key is a secret: only ever put it in .env / Render, never in git.
# ONESIGNAL_APP_ID=
# ONESIGNAL_API_KEY=

PORT=8000
